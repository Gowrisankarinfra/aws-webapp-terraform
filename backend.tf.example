# Example only. Rename to backend.tf after creating the bucket separately.
# The bucket must already exist before `terraform init`.
terraform {
  backend "s3" {
    bucket       = "REPLACE_WITH_YOUR_UNIQUE_STATE_BUCKET"
    key          = "gowri-web-lab/terraform.tfstate"
    region       = "ap-south-1"
    encrypt      = true
    use_lockfile = true
  }
}
